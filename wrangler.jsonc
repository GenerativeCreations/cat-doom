{
  // Cloudflare Workers static-assets config. `npx wrangler login` once, then `npx wrangler deploy`
  // uploads ./public, attaches the custom domains below (DNS + certificate handled by Cloudflare), done.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cat-doom",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "cat-doom.com", "custom_domain": true },
    { "pattern": "www.cat-doom.com", "custom_domain": true }
  ],
  "observability": { "enabled": false }
}
